node_modules/
.DS_Store
*.log
.env

# profilo Chrome temporaneo (utile quando la cartella temporanea di sistema non è scrivibile)
.chrome-tmp/

# export per squadra generati a runtime (es. promozione-c_centro_storico_lebowski.ics):
# sono artefatti utente, non fanno parte dei dati pubblicati
data/exports/*_*.ics
data/exports/*_*.csv
data/exports/*_*.json

# database SQLite locale
data/db/*.sqlite
data/db/*.sqlite-journal
data/db/*.sqlite-wal
data/db/*.sqlite-shm
data/db/*.sqlite.bak
# backup con timestamp (es. calcio.sqlite.2026-10-19T00-30-00-000Z.bak)
data/db/*.sqlite.*.bak

# Evita duplicazione tra data/cache e data/exports per i file JSON completi
data/exports/*.json

# File temporanei generati da scritture atomiche o processi interrotti
*.tmp
**/*.tmp
