{
  "name": "calcio-toscana-scraper",
  "version": "1.0.0",
  "description": "Scraper e tool calendari per i campionati dilettantistici toscani",
  "main": "bin/cli.js",
  "scripts": {
    "start": "node bin/cli.js serve",
    "serve": "node bin/cli.js serve",
    "scrape": "node bin/cli.js scrape all",
    "standings": "node bin/cli.js standings",
    "calendar": "node bin/cli.js calendar",
    "next": "node bin/cli.js next",
    "results": "node bin/cli.js results",
    "scorers": "node bin/cli.js scorers",
    "db:import": "node bin/db-import.js",
    "db:dump": "node bin/db-snapshot.js dump",
    "db:restore": "node bin/db-snapshot.js restore",
    "db:status": "node bin/db-snapshot.js status",
    "export": "node bin/cli.js export all",
    "build:pages": "node bin/build-pages.js",
    "check:pages": "node bin/build-pages.js --check",
    "test": "node --test",
    "verify": "npm run check:pages && npm test",
    "sync": "node bin/cli.js scrape all --refresh -i && node bin/db-import.js && node bin/db-snapshot.js dump && node bin/cli.js export all && npm run build:pages && git add data/cache/ data/exports/ data/db/snapshot.jsonl && git commit -m \"chore(data): aggiornamento calendari e classifiche\" && git push origin main",
    "parity": "node bin/parity-check.js"
  },
  "bin": {
    "calcio-toscana": "./bin/cli.js"
  },
  "keywords": [
    "calcio",
    "toscana",
    "scraper",
    "calendario",
    "classifica"
  ],
  "author": "cicciocanestro",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "linkedom": "^0.18.13",
    "puppeteer-core": "^25.12.0"
  }
}
